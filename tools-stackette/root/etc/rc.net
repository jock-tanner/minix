# Start the network.  Edit the addresses for your LAN, then: sh /etc/rc.net
IP=192.168.1.50
MASK=255.255.255.0
GW=192.168.1.1
/bin/inet &
sleep 2
/usr/bin/ifconfig -h $IP -n $MASK
/usr/bin/add_route -g $GW

/usr/bin/tcpd telnet /usr/bin/telnetd &
/usr/bin/tcpd ftp /usr/bin/ftpd &
echo network up: $IP
