# the stackette machine on the target: C programs for Minix (separate I&D)
var w=2
var wa=2
var p=2
var pa=2
var s=2
var sa=2
var l=4
var la=2
var f=4
var fa=2
var d=8
var da=2
var x=8
var xa=2
var ARCH=stackette
var PLATFORM=stackette
var PLATFORMDIR={EM}/share/ack/{PLATFORM}
var MINIXDIR={EM}/share/ack/minix
var CPP_F=-D__unix -D__stackette -D__ACK__=1
var ALIGN=-a0:2 -a1:2 -a2:2 -a3:2
var CC_ALIGN=-Vy
var C_INCLUDES=-I{EM}/share/ack/{PLATFORM}/include -I{EM}/share/ack/include/ansi

name be
	from .m.g
	to .s
	program {EM}/lib/ack/{PLATFORM}/ncg
	args <
	stdout
	need .e
end
name as
	from .s
	to .o
	program {EM}/lib/ack/{PLATFORM}/as
	args - -o > <
	prep cond
end
name led
	from .o.a
	to .out
	program {EM}/lib/ack/mled
	mapflag -l* LNAME={MINIXDIR}/lib*
	args {ALIGN} -b1:0 \
		(.e:{HEAD}={MINIXDIR}/crtso.o) \
		-o > < \
		(.ocm.bas.mod.b.c.p:{TAIL}={MINIXDIR}/libsys.a {MINIXDIR}/libc.a {MINIXDIR}/libm.a) \
		(.e:{TAIL}={PLATFORMDIR}/libem.a {PLATFORMDIR}/libfp.a {PLATFORMDIR}/libend.a)
	linker
end
